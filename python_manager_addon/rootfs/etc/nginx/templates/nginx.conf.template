worker_processes 1;
pid /tmp/nginx.pid;

events { worker_connections 512; }

http {
    include       mime.types;
    default_type  application/octet-stream;
    client_max_body_size 20m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ==========================================================
    # 8099 : ENTREE INGRESS UNIQUEMENT
    # Reachable seulement via le Supervisor (jamais publié sur l'hôte,
    # cf. absence de "8099/tcp" dans config.yaml -> ports:)
    # Sert : UI d'admin, éditeur de scripts, API backend, terminal web.
    # ==========================================================
    server {
        listen 8099;

        # UI + API backend
        location / {
            proxy_pass http://127.0.0.1:8000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Terminal web (ttyd) - websocket
        location /terminal/ {
            proxy_pass http://127.0.0.1:7681/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
        }
    }

    # ==========================================================
    # 8090 : SEUL PORT PUBLIÉ SUR L'HOTE (cf. config.yaml -> ports:)
    # Ne sert QUE le routage /s/<script>/ vers les scripts qui
    # tournent réellement et exposent un port web. Tout le reste
    # renvoie 404 : ni l'UI, ni l'API, ni le terminal ne sont
    # accessibles depuis ce port.
    # ==========================================================
    server {
        listen 8090 default_server;

        location / {
            return 404;
        }

        # Bloc généré/regénéré dynamiquement par le backend
        # (un "location /s/<name>/ { proxy_pass http://127.0.0.1:<port>/; }" par script actif)
        include /etc/nginx/conf.d/dynamic_scripts.conf;
    }
}
